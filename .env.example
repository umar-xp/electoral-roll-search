# Electoral Roll Search - Configuration
# Copy this file to .env and fill in your machine-specific values.
# These override the auto-detected defaults in packages/data-pipeline/config/settings.py

# Tesseract OCR binary path
# Windows: C:\Users\<you>\AppData\Local\Programs\Tesseract-OCR\tesseract.exe
# macOS:   /opt/homebrew/bin/tesseract
# Linux:   /usr/bin/tesseract (usually auto-detected)
# TESSERACT_CMD=

# Tesseract trained data directory (tessdata_best recommended)
# Windows: C:\Users\<you>\AppData\Local\Programs\Tesseract-OCR\tessdata
# macOS:   /opt/homebrew/share/tessdata
# Linux:   /usr/share/tesseract-ocr/5/tessdata
# TESSDATA_PREFIX=

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
